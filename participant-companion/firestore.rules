rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
//  Firestore Security Rules — participant-companion (read-only mini-site)
//
//  Strategy:
//    • The companion app queries the SAME 'registrations' collection used by
//      the admin app. Each registration has a 'companionToken' UUID field.
//    • LIST queries are allowed so the app can do:
//        where('companionToken', '==', token).limit(1)
//    • Direct reads by document ID are blocked — the caller must already know
//      the token UUID (effectively a secret; brute-force is infeasible).
//    • All write operations are blocked from the client.
//    • Deploy via: firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── registrations ────────────────────────────────────────────────────────
    // Allow LIST only — companion app uses where('companionToken','==',token)
    match /registrations/{regId} {
      allow list : if request.query.limit <= 1;
      allow get  : if false;
      allow write: if false;
    }

    // ── trips ────────────────────────────────────────────────────────────────
    // Trip documents contain only non-sensitive itinerary metadata.
    match /trips/{tripId} {
      allow read : if true;
      allow write: if false;
    }

    // ── schedule_items ───────────────────────────────────────────────────────
    // Participants query: where('tripId','==', <ref>)
    match /schedule_items/{itemId} {
      allow read : if true;
      allow write: if false;
    }

    // ── Catch-all: deny everything else ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
