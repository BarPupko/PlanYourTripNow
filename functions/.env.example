# Copy to functions/.env and fill in. functions/.env is gitignored - never commit real values.

# ── Email (existing) ────────────────────────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=

# ── Claude (existing) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── PayPal ──────────────────────────────────────────────────────────────────
# From developer.paypal.com → Apps & Credentials. Make sure you are on the
# Sandbox tab while testing and the Live tab for production - the credentials
# are different and are not interchangeable.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# 'sandbox' (default) or 'live'. Controls which PayPal API host is used.
PAYPAL_ENV=sandbox

# From developer.paypal.com → your app → Webhooks. Create a webhook pointing at
#   https://us-central1-planyourtrip-ed010.cloudfunctions.net/paypalWebhook
# subscribed to PAYMENT.CAPTURE.COMPLETED, then paste its ID here.
# Without this the webhook refuses every delivery rather than trusting it.
PAYPAL_WEBHOOK_ID=

# Public origin the site is served from, no trailing slash. Used for the PayPal
# return/cancel URLs and for the gift card links in emails.
# Defaults to https://barpupko.github.io/PlanYourTripNow if unset.
PUBLIC_SITE_URL=https://barpupko.github.io/PlanYourTripNow
