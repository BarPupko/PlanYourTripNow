rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Trips collection - only admins can write, everyone can read
    match /trips/{tripId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Registrations collection
    match /registrations/{registrationId} {
      // Anyone can create a registration (public form)
      allow create: if true;

      // Allow reading registrations to see occupied seats (public)
      allow read: if true;

      // Authenticated users (admins) can update/delete anything
      allow update, delete: if request.auth != null;

      // Public users can update a form_sent registration to confirmed (completing the emailed form)
      allow update: if resource.data.status == 'form_sent'
                    && request.resource.data.status == 'confirmed';
    }

    // Contacts collection - admin only
    match /contacts/{contactId} {
      allow read, write: if request.auth != null;
    }

    // Gift Cards collection
    match /giftCards/{giftCardId} {
      // Anyone can read gift cards (public reveal page)
      allow read: if true;

      // Only authenticated users (admins) can create gift cards
      allow create: if request.auth != null;

      // Only authenticated users (admins) can delete gift cards
      allow delete: if request.auth != null;

      // Allow anyone to update viewed status (when user opens the gift card reveal page)
      // Only authenticated users (admins) can update other fields like remainingBalance and usageHistory
      allow update: if request.auth != null ||
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewed', 'viewedAt']));
    }
  }
}
