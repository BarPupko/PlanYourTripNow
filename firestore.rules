rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null;
    }

    // ─── Trips ──────────────────────────────────────────────────────────────
    // Trips are public information — needed by the landing page and registration
    // form, both of which are accessible without authentication.
    match /trips/{tripId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Registrations ──────────────────────────────────────────────────────
    match /registrations/{registrationId} {
      // Public can create a new registration (open booking form)
      allow create: if true;

      // Public read is required for:
      //   - The registration form (checks taken seat numbers before assigning)
      //   - The landing page (counts registrations per trip for availability display)
      allow read: if true;

      // Admin can update/delete
      allow update, delete: if isAdmin();

      // Public can advance their own registration from form_sent → confirmed
      // (completes the emailed registration link — no auth needed)
      allow update: if resource.data.status == 'form_sent'
                    && request.resource.data.status == 'confirmed'
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['status', 'confirmedAt',
                                   'firstName', 'lastName', 'email',
                                   'phone', 'passengers', 'preferredPickupPlace',
                                   'passportNumber', 'dateOfBirth', 'nationality']);
    }

    // ─── Admins ─────────────────────────────────────────────────────────────
    // Any logged-in user can read admin docs (to check their role).
    // Only admins can create/update/delete admin and writer records.
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ─── Writers ─────────────────────────────────────────────────────────────
    match /writers/{uid} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ─── Contacts ───────────────────────────────────────────────────────────
    // Admin-only (internal address book, PII)
    match /contacts/{contactId} {
      allow read, write: if isAdmin();
    }

    // ─── Feedbacks ──────────────────────────────────────────────────────────
    // Anyone with the token link can submit once (doc ID = companionToken).
    // Admins can read all. Nobody can update/delete after submission.
    match /feedbacks/{token} {
      allow read: if isAdmin();

      // Public create: allowed only if the doc doesn't already exist
      // (Firestore create semantics already guarantee this, but be explicit)
      allow create: if !exists(/databases/$(database)/documents/feedbacks/$(token));

      // No updates or deletes — feedback is immutable once submitted
      allow update, delete: if isAdmin();
    }

    // ─── Schedule Items ─────────────────────────────────────────────────────
    // Used by the public participant companion app — read is public
    match /schedule_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Questions ──────────────────────────────────────────────────────────
    // Visitors (unauthenticated) can submit questions from the landing page.
    // Only admins can read, update (mark read), or delete.
    match /questions/{questionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ─── Gift Cards ─────────────────────────────────────────────────────────
    match /giftCards/{giftCardId} {
      // Public reveal page needs to read the gift card
      allow read: if true;

      // Only admin can create/delete
      allow create, delete: if isAdmin();

      // Admin can update anything; public can only mark as viewed
      allow update: if isAdmin()
                    || request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['viewed', 'viewedAt']);
    }

    // ─── Blog Posts ──────────────────────────────────────────────────────────
    match /blogPosts/{postId} {
      // Published posts are publicly readable; drafts are admin-only
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // ─── Blog Comments ───────────────────────────────────────────────────────
    match /blogComments/{commentId} {
      // Anyone can submit a comment; only approved comments are publicly readable
      allow create: if true;
      allow read: if resource.data.approved == true || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─── Site Settings ───────────────────────────────────────────────────────
    // Landing page reads section order and visibility flags; admin writes.
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

  }
}
